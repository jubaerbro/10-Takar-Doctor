# Copy to .env and fill in. Never commit the real file.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
# First super admin, created the first time the server starts
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
# Web address of the admin panel, once it exists (comma-separated list)
CORS_ORIGINS=
# Video calls (LiveKit). Leave empty until you have an account.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 1 = development only: OTP codes are returned by the API and fake top-ups are allowed. Must be 0 in production.
DEV_MODE=0
